{
  "nodeVersion": "26.8.1",
  "npmVersion": "12.0.2",
  "requiredScripts": [
    "format:check",
    "lint",
    "typecheck",
    "test:unit",
    "test:integration",
    "build",
    "build:runtime",
    "start",
    "smoke:electron",
    "test:performance",
    "audit:ci",
    "version:check",
    "package:win",
    "smoke:installer"
