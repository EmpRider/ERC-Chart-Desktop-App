{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erc-chart.local/schemas/calibration-evidence.schema.json",
  "title": "ERC Chart delivery calibration evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calibratedAt",
    "maintainer",
    "taskPullRequest",
    "taskHeadSha",
    "epicPullRequest",
    "epicHeadSha",
    "qodoCapacity",
    "reviewers",
    "assertions"
  ],
  "properties": {
    "calibratedAt": { "type": "string", "format": "date-time" },
    "maintainer": { "const": "EmpRider" },
    "taskPullRequest": { "type": "integer", "minimum": 1 },
    "taskHeadSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "epicPullRequest": { "type": "integer", "minimum": 1 },
    "epicHeadSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "qodoCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "displayText", "active", "exactEndsOn"],
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "displayText": { "const": "Day 1 of 14 · Trial" },
        "active": { "const": true },
        "exactEndsOn": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        }
      }
    },
    "reviewers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coderabbit", "semgrep", "qodo", "codeReviewAi"],
      "properties": {
        "coderabbit": { "$ref": "#/$defs/reviewer" },
        "semgrep": {
          "allOf": [
            { "$ref": "#/$defs/reviewer" },
            {
              "type": "object",
              "properties": { "representation": { "const": "check" } }
            }
          ]
        },
        "qodo": { "$ref": "#/$defs/reviewer" },
        "codeReviewAi": { "$ref": "#/$defs/reviewer" }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soloMaintainer",
        "coderabbitComprehensive",
        "semgrepBlocks",
        "qodoTaskAndEpic",
        "codeReviewAiEpicOnly",
        "requiredStatusesBlock",
        "staleBranchBlocks",
        "unresolvedConversationBlocks",
        "mergeMethodsEnforced",
        "directPushRejected",
        "forcePushRejected",
        "documentationMergeCreatedNoRelease"
      ],
      "properties": {
        "soloMaintainer": { "const": true },
        "coderabbitComprehensive": { "const": true },
        "semgrepBlocks": { "const": true },
        "qodoTaskAndEpic": { "const": true },
        "codeReviewAiEpicOnly": { "const": true },
        "requiredStatusesBlock": { "const": true },
        "staleBranchBlocks": { "const": true },
        "unresolvedConversationBlocks": { "const": true },
        "mergeMethodsEnforced": { "const": true },
        "directPushRejected": { "const": true },
        "forcePushRejected": { "const": true },
        "documentationMergeCreatedNoRelease": { "const": true }
      }
    }
  },
  "$defs": {
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "representation", "observedContexts"],
      "properties": {
        "login": { "type": "string", "minLength": 1 },
        "representation": {
          "enum": ["check", "review", "comment"]
        },
        "observedContexts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
